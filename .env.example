# Copy this file to .env and fill in your own values. Never commit .env.
#
# Personal API token: Todoist -> Settings -> Integrations -> Developer.
# 40 hexadecimal characters. It does not expire and it has no scopes,
# so it grants full access to the account it belongs to.
TODOIST_API_TOKEN=

# Base URL of the environment under test.
# Leave empty to use production (https://app.todoist.com/api/v1).
TODOIST_BASE_URL=

# Optional. A token of a *different* account, used only by TC-20.3
# (accessing someone else's resource). Tests that need it are skipped
# with an explicit annotation when it is missing.
TODOIST_API_TOKEN_SECONDARY=

# Number of Playwright workers. Keep at 1 until the account limits are
# understood - the Free plan caps at 5 projects, which caps at 2 workers.
TEST_WORKERS=1
